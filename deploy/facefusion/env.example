# ml-compositor env fayl shabloni. /etc/ml-compositor.env ga ko'chiring.

# FaceFusion CLI (install.sh default)
FACEFUSION_DIR=/opt/facefusion
FACEFUSION_PY=/opt/facefusion/.venv/bin/python
FACEFUSION_TIMEOUT_S=240

# Agar API serveri boshqa VPS'da bo'lsa — DATABASE/S3 ulanish shart emas,
# chunki ml-compositor faqat HTTP input oladi va JPEG qaytaradi. API serveri
# natija bilan nima qilishni o'zi hal qiladi.

# Qo'shimcha: debug uchun verbose log
# LOG_LEVEL=debug
