# N24:31 production env. Copy to .env.production on the server and fill in.
# NEVER commit the filled-in copy.

# --- Public URLs ---
API_DOMAIN=api.n2431.app
API_URL=https://api.n2431.app
CORS_ORIGIN=https://seller.n2431.app,https://n2431.app

# --- Postgres ---
POSTGRES_USER=n2431
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=n2431

# --- JWT ---
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_TTL=30d
JWT_REFRESH_TTL=90d

# --- Cloudflare R2 (images) ---
STORAGE_DRIVER=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=n2431-uploads
R2_PUBLIC_URL=https://cdn.n2431.app

# --- Payme (production sandbox first) ---
PAYME_KEY=
USD_UZS_RATE=12800

# --- Eskiz.uz SMS (production credits required) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Let's Encrypt bootstrap ---
# Only used by scripts/ssl-init.sh on first run.
LETSENCRYPT_EMAIL=you@example.com

# --- Node ---
NODE_ENV=production
