# Database
DATABASE_URL="postgresql://n2431:n2431dev@localhost:5432/n2431?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Object storage — pick a driver. Default is local disk (works out of the box
# for `pnpm dev`); switch to r2 for staging/prod so images serve from CDN.
STORAGE_DRIVER="local"       # "local" | "r2"
STORAGE_ROOT="./uploads"     # local driver: on-disk directory

# Cloudflare R2 (only when STORAGE_DRIVER=r2). Create bucket + API token at
# dash.cloudflare.com → R2, then paste the values here.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="n2431-uploads"
# Where the public reads happen — either the default pub-*.r2.dev host that
# R2 assigns when you enable public access, or a custom domain you point at
# the bucket (e.g. https://cdn.n2431.app).
R2_PUBLIC_URL="https://pub-XXXX.r2.dev"

# API
API_PORT=4000
API_HOST=0.0.0.0
API_URL="http://localhost:4000"

# JWT
JWT_SECRET="dev-secret-change-me-in-production"
JWT_ACCESS_TTL="30d"
JWT_REFRESH_TTL="90d"

# OTP (Eskiz.uz)
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# Payment (Payme)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# ML services
ML_FACE_URL="http://localhost:5001"
ML_COMPOSITOR_URL="http://localhost:5002"
FACE_TEMPLATE_TTL_DAYS=30

# Mobile
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_CDN_URL="http://localhost:9000/n2431-dev"

# Logging
LOG_LEVEL="debug"
NODE_ENV="development"
