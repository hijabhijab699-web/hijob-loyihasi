{
  "expo": {
    "name": "24:31",
    "slug": "n2431",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "n2431",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#8A8D5B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.n2431.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera yuzingizni skanerdan o'tkazish va kiyimlarni kiyib ko'rish uchun kerak.",
        "NSPhotoLibraryUsageDescription": "Kutubxonaga faqat sizning ruxsatingiz bilan kirish."
      }
    },
    "android": {
      "package": "app.n2431.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8A8D5B"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "24:31 kamerani yuzingizni skanerlash uchun ishlatadi."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "24:31 real-time try-on uchun kameraga ruxsat so'raydi.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlayfairDisplay.ttf",
            "./assets/fonts/Inter.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.2431.uz/api/v1"
    }
  }
}